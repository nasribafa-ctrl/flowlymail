# Copy this file to .env.local and fill in your own values.
# Never commit real values.

# --- Supabase (auth + Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only, bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Gmail connection) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud, e.g. http://localhost:3000/api/gmail/callback
GOOGLE_REDIRECT_URI=
# Full Pub/Sub topic name: projects/<project-id>/topics/<topic-name>
GOOGLE_PUBSUB_TOPIC=
# Shared secret expected as ?token=... on the Pub/Sub push endpoint /api/gmail/webhook
GMAIL_WEBHOOK_SECRET=

# --- Encryption ---
# HMAC key for the signed OAuth state. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=
# AES-256-GCM key for Gmail tokens (must decode to 32 bytes). Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- n8n ---
# Shared secret sent by n8n / the processing API in the x-n8n-secret header (token broker)
N8N_INTERNAL_SECRET=
# n8n webhook URL called when a new Gmail notification arrives
N8N_GMAIL_PUSH_WEBHOOK_URL=

# --- Vercel Cron ---
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the /api/internal/* cron routes
CRON_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Onboarding (business description generated from the client's website) ---
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=

# --- Alerts (optional) ---
# Discord webhook notified on unexpected server errors. Leave empty to disable.
DISCORD_ALERT_WEBHOOK_URL=
